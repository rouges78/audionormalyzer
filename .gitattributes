# Normalize line endings: all text in LF in the repo
* text=auto eol=lf

# Scripts that MUST stay CRLF on Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.node binary
*.wav binary
*.mp3 binary
*.flac binary
*.ogg binary
*.m4a binary
