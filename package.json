{
  "name": "audio-normalizer",
  "version": "0.1.0",
  "description": "Professional audio level normalization tool with EBU R128 compliance",
  "author": "Audio Normalizer Team",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "setup:audio": "node scripts/setup-audio-env.js",
    "test:audio": "node scripts/test-audio-setup.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run services/__tests__/**/*.test.ts",
    "test:integration": "vitest run __tests__/integration/**/*.test.ts",
    "test:api": "vitest run app/api/**/__tests__/**/*.test.ts",
    "test:comprehensive": "node scripts/run-comprehensive-tests.js",
    "test:watch": "vitest",
    "clean:temp": "rimraf temp/audio/* output/audio/*",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:pack": "npm run build && electron-builder",
    "electron:dist": "npm run build && electron-builder --publish=never",
    "build:exe": "node scripts/build-exe.js",
    "build:exe:quick": "npm run build && electron-builder --win portable --x64",
    "build:exe:safe": "npm run build && timeout /t 3 && electron-builder --win portable --x64 --config electron-builder.config.js",
    "build:exe:force": "rimraf dist && npm run build && electron-builder --win portable --x64",
    "build:simple": "npm run build && electron-builder --win --x64",
    "diagnose": "node scripts/diagnose.js",
    "fix-build": "node scripts/fix-build.js",
    "test-exe": "node scripts/test-exe.js",
    "build:full-ui": "node scripts/build-full-ui.js",
    "build:no-icon": "node scripts/build-no-icon.js",
    "build:minimal": "node scripts/build-minimal.js",
    "build:working": "node scripts/build-working-exe.js",
    "build:final": "node scripts/build-final-exe.js",
    "test:exe": "node scripts/test-exe.js",
    "build:standalone": "node scripts/build-standalone-exe.js",
    "build:real-audio": "node scripts/build-real-audio-exe.js",
    "build:professional": "node scripts/build-professional-viz-exe.js",
    "build:desktop": "node scripts/build-desktop-app.js",
    "build:dist": "node scripts/build-distribution.js",
    "build:dist:web": "node scripts/build-distribution.js web",
    "build:dist:desktop": "node scripts/build-distribution.js desktop",
    "build:dist:docker": "node scripts/build-distribution.js docker",
    "build:all": "node scripts/build-distribution.js web desktop docker",
    "docker:build": "docker build -t audionormalizer/audio-normalizer:latest .",
    "docker:dev": "docker-compose -f docker-compose.yml --profile dev up",
    "docker:prod": "docker-compose up -d",
    "release": "npm run build:all && npm run test:comprehensive",
    "postinstall": "electron-builder install-app-deps"
  },
  "main": "electron/main.js",
  "homepage": "./",
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@types/archiver": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "archiver": "^7.0.1",
    "audio-buffer-utils": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "geist": "^1.3.1",
    "input-otp": "1.4.1",
    "loudness": "^0.4.2",
    "lucide-react": "^0.454.0",
    "music-metadata": "^11.8.2",
    "next": "15.2.4",
    "next-themes": "^0.4.6",
    "node-id3": "^0.2.9",
    "react": "^19",
    "react-day-picker": "9.8.0",
    "react-dom": "^19",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "vaul": "^0.9.9",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^8.2.2",
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.audionormalizer.app",
    "productName": "Audio Normalizer Professional",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "package.json",
      "!**/*.test.*",
      "!**/__tests__/**/*",
      "!.next/**/*",
      "!node_modules/**/*",
      "!scripts/**/*",
      "!docs/**/*",
      "!**/*.md"
    ],
    "win": {
      "target": "portable"
    }
  }
}
